{
  "name": "openai-platform-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable dark-first OpenAI Platform design system for React projects",
  "files": [
    "dist-package",
    "src/index.ts",
    "src/components",
    "src/mocks",
    "src/styles",
    "src/tokens",
    "src/vite-env.d.ts",
    "docs/design-system",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist-package/openai-platform-design-system.js"
    },
    "./styles.css": "./dist-package/openai-platform-design-system.css"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:library": "npm run tokens:build && vite build --config vite.lib.config.ts",
    "visual:extract": "python3 scripts/extract_reference_screenshots.py",
    "visual:diff": "node scripts/visual_diff.mjs",
    "visual:fixture": "node scripts/visual_fixture_diff.mjs",
    "tokens:build": "node scripts/build_tokens.mjs",
    "tokens:sd:check": "style-dictionary build --config style-dictionary.config.mjs",
    "tokens:check": "node scripts/check_tokens.mjs",
    "ds:check": "node scripts/check-literals.mjs",
    "ds:verify": "npm run tokens:check && npm run ds:check && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@openai/apps-sdk-ui": "^0.2.2",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "storybook": "^10.6.7",
    "style-dictionary": "^4.4.0",
    "tailwindcss": "^4.3.5"
  }
}
