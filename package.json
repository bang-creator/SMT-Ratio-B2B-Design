{
  "name": "openai-platform-design-system",
  "version": "0.1.0",
  "private": true,
  "description": "Token-backed OpenAI Platform design system for plain HTML, CSS, and JavaScript prototypes",
  "files": ["vanilla", "tokens", "docs/design-system", "scripts", "README.md", "AGENTS.md", "CONTRIBUTING.md"],
  "exports": {
    ".": "./vanilla/design-system.js",
    "./styles.css": "./vanilla/design-system.css",
    "./vanilla.css": "./vanilla/design-system.css",
    "./vanilla.js": "./vanilla/design-system.js",
    "./tokens.css": "./tokens/tokens.css",
    "./tokens.dark.css": "./tokens/tokens.dark.css"
  },
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "build:vanilla": "node scripts/build_vanilla.mjs",
    "tokens:build": "node scripts/build_tokens.mjs",
    "tokens:check": "node scripts/check_tokens.mjs",
    "ds:check": "node scripts/check-literals.mjs",
    "ds:verify": "npm run tokens:check && npm run ds:check && npm run build:vanilla && npm run build-storybook"
  },
  "devDependencies": {
    "@storybook/html-vite": "10.6.7",
    "storybook": "10.6.7"
  }
}
